<Window
    x:Class="Valorant_Instalocker.CustomMessageBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Onay"
    Width="400"
    Height="200"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Border
        Background="#1E293B"
        BorderBrush="#334155"
        BorderThickness="2"
        CornerRadius="15">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="TitleText"
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#EF4444"
                Text="ONAY" />

            <TextBlock
                x:Name="MessageText"
                Grid.Row="1"
                VerticalAlignment="Center"
                FontSize="15"
                Foreground="#CBD5E1"
                Text="Mesaj içeriği..."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Row="2"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="0,0,10,0"
                    Background="#475569"
                    Click="No_Click"
                    Content="HAYIR"
                    Style="{StaticResource ModernButton}" />

                <Button
                    Width="100"
                    Click="Yes_Click"
                    Content="EVET"
                    Style="{StaticResource ModernButton}" />

            </StackPanel>
        </Grid>
    </Border>
</Window>