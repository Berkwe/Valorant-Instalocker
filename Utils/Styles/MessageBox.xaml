<Window x:Class="Valorant_Instalocker.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onay" Height="200" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

	<Border Background="#1E293B" CornerRadius="15" BorderBrush="#334155" BorderThickness="2">
		<Grid Margin="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock x:Name="TitleText" Text="ONAY" Foreground="#EF4444" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,10"/>

			<TextBlock x:Name="MessageText" Grid.Row="1" Text="Mesaj içeriği..." Foreground="#CBD5E1" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>

			<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
				<Button Content="HAYIR" Width="100" Background="#475569" Style="{StaticResource ModernButton}" Click="No_Click" Margin="0,0,10,0"/>

				<Button Content="EVET" Width="100" Style="{StaticResource ModernButton}" Click="Yes_Click" />

			</StackPanel>
		</Grid>
	</Border>
</Window>