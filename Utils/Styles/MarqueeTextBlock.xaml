<UserControl
    x:Class="Valorant_Instalocker.Utils.Styles.MarqueeTextBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ClipToBounds="True">
    <Grid>
        <StackPanel
            x:Name="PART_Stack"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                x:Name="PART_Text"
                Foreground="{DynamicResource TextSecondary}"
                TextTrimming="None"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="PART_TextCopy"
                Foreground="{DynamicResource TextSecondary}"
                TextTrimming="None"
                TextWrapping="NoWrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>