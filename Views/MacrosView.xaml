<UserControl x:Class="Valorant_Instalocker.Views.MacrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="MacrosSection">
        <StackPanel>
            <TextBlock Text="{DynamicResource MacrosTitle}" Foreground="{DynamicResource AccentPrimary}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="{DynamicResource MacrosDesc}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="12" BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,0" Grid.ColumnSpan="2">
                    <StackPanel>
                        <TextBlock Text="Coming Soon..." FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>