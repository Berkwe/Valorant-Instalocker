<UserControl
    x:Class="Valorant_Instalocker.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="AboutSection">
        <Border
            Padding="30"
            Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource DefaultBorder}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AccentPrimary}"
                    Text="{DynamicResource AboutTitle}" />
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="{DynamicResource TextMuted}"
                    Text="{DynamicResource AboutDesc}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,30"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AccentWarning}"
                    Text="{DynamicResource AboutWarning}" />

                <Rectangle
                    Height="1"
                    Margin="0,0,0,20"
                    Fill="{DynamicResource SeparatorBrush}" />
                <TextBlock
                    Margin="0,0,0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{DynamicResource DevTeamTitle}" />

                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="180"
                        Margin="0,0,10,0"
                        Padding="15"
                        Background="{DynamicResource AppBackground}"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="40"
                                Height="40"
                                Margin="0,0,10,0"
                                Background="{DynamicResource AccentPrimary}"
                                CornerRadius="20">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="BW" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="Berkwe" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource LeadDevRole}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border
                        Width="180"
                        Margin="0,0,10,0"
                        Padding="15"
                        Background="{DynamicResource AppBackground}"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="40"
                                Height="40"
                                Margin="0,0,10,0"
                                Background="{DynamicResource AccentSecondary}"
                                CornerRadius="20">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="AS" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="Asistan" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource UIDevRole}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>