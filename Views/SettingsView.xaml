<UserControl x:Class="Valorant_Instalocker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="SettingsSection">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"  Background="{DynamicResource SurfaceBackground}" CornerRadius="12" BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="1" Padding="20" Margin="0,0,10,0">
            <StackPanel>


                <TextBlock Text="{DynamicResource SettingsLanguage}" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="LanguageComboBox" Style="{StaticResource InstalockerComboBoxStyle}"  FontSize="14" Padding="8" Margin="0,0,0,20" SelectionChanged="LanguageCombo_SelectionChanged">

                    <ComboBoxItem Content="Türkçe" IsSelected="True" Tag="TR"/>
                    <ComboBoxItem Content="English" Tag="EN"/>
                </ComboBox>

                <TextBlock Text="{DynamicResource SettingsThemesConfig}" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="ThemeComboBox" Style="{StaticResource InstalockerComboBoxStyle}" FontSize="14" Padding="8" Margin="0,0,0,20"  SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource SettingsDarkTheme}" IsSelected="True" Tag="dark"/>
                    <ComboBoxItem Content="{DynamicResource SettingsLightTheme}"  Tag="light"/>
                    <!-- <ComboBoxItem Content="{DynamicResource SettingsCustomTheme}" Tag="custom"/> -->
                </ComboBox>


                <Button Content="{DynamicResource SettingsSaveBtn}" Style="{StaticResource ModernButton}" Click="SettingsSaveBtn_Click" HorizontalAlignment="Right" Padding="20,10"/>
            </StackPanel>
        </Border>


    </Grid>
</UserControl>