<UserControl
    x:Class="Valorant_Instalocker.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="SettingsSection">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Column="0"
            Margin="0,0,10,0"
            Padding="20"
            Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource DefaultBorder}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel>


                <TextBlock
                    Margin="0,0,0,5"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource SettingsLanguage}" />
                <ComboBox
                    x:Name="LanguageComboBox"
                    Margin="0,0,0,20"
                    Padding="8"
                    FontSize="14"
                    SelectionChanged="LanguageCombo_SelectionChanged"
                    Style="{StaticResource InstalockerComboBoxStyle}">

                    <ComboBoxItem
                        Content="Türkçe"
                        IsSelected="True"
                        Tag="TR" />
                    <ComboBoxItem Content="English" Tag="EN" />
                </ComboBox>

                <TextBlock
                    Margin="0,0,0,5"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource SettingsThemesConfig}" />
                <ComboBox
                    x:Name="ThemeComboBox"
                    Margin="0,0,0,20"
                    Padding="8"
                    FontSize="14"
                    SelectionChanged="ThemeCombo_SelectionChanged"
                    Style="{StaticResource InstalockerComboBoxStyle}">
                    <ComboBoxItem
                        Content="{DynamicResource SettingsDarkTheme}"
                        IsSelected="True"
                        Tag="dark" />
                    <ComboBoxItem Content="{DynamicResource SettingsLightTheme}" Tag="light" />
                </ComboBox>


                <Button
                    Padding="20,10"
                    HorizontalAlignment="Right"
                    Click="SettingsSaveBtn_Click"
                    Content="{DynamicResource SettingsSaveBtn}"
                    Style="{StaticResource ModernButton}" />
            </StackPanel>
        </Border>


    </Grid>
</UserControl>