<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Valorant_Instalocker</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icons\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\icons\discord.png" />
    <None Remove="Assets\icons\github.png" />
    <None Remove="Assets\icons\instalocker-TUI.ico" />
    <None Remove="Assets\icons\lead.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icons\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RadiantConnect" Version="10.6.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icons\discord.png" />
    <Resource Include="Assets\icons\github.png" />
    <Resource Include="Assets\icons\instalocker-TUI.ico" />
    <Resource Include="Assets\icons\lead.jpg" />
  </ItemGroup>

</Project>
