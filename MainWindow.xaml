<Window
    x:Class="Valorant_Instalocker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:main="clr-namespace:Valorant_Instalocker.Main"
    Title="Valorant Instalocker"
    Width="950"
    Height="700"
    Background="{DynamicResource AppBackground}"
    FontFamily="Segoe UI"
    WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource DefaultBorder}"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="36"
                        Height="36"
                        Margin="0,0,10,0"
                        Background="{DynamicResource AccentPrimary}"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="🎯" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="Black"
                        Text="INSTALOCKER">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0.0" Color="#EF4444" />
                                <GradientStop Offset="1.0" Color="#FB7185" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BtnNavDashboard"
                        BorderBrush="{DynamicResource AccentPrimary}"
                        Click="SwitchTab_Click"
                        Content="{DynamicResource HomeTab}"
                        Foreground="{DynamicResource AccentPrimary}"
                        Style="{StaticResource TabButton}" />
                    <Button
                        x:Name="BtnNavMacros"
                        Click="SwitchTab_Click"
                        Content="{DynamicResource MacrosTab}"
                        Style="{StaticResource TabButton}" />
                    <Button
                        x:Name="BtnNavSettings"
                        Click="SwitchTab_Click"
                        Content="{DynamicResource SettingsTab}"
                        Style="{StaticResource TabButton}" />
                    <Button
                        x:Name="BtnNavAbout"
                        Margin="0"
                        Click="SwitchTab_Click"
                        Content="{DynamicResource AboutTab}"
                        Style="{StaticResource TabButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <ContentControl x:Name="MainContent" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,0,5,5"
            Padding="8"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource SeparatorBrush}"
            BorderBrush="{DynamicResource DefaultBorder}"
            BorderThickness="1"
            CornerRadius="20"
            RenderTransformOrigin="0.983,1.498">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusCircle}" />
                <TextBlock
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{DynamicResource TextPrimary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource ClientConnecting}" />
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="MaxWidth" Value="200" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsClientLoggedIn, Source={x:Static main:AppStateManager.Instance}}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource ClientConnected}" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:1.2" />
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="MaxWidth"
                                                    To="0"
                                                    Duration="0:0:1.5">
                                                    <DoubleAnimation.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseInOut" Exponent="5" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>

                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.4" />
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="MaxWidth"
                                                    To="200"
                                                    Duration="0:0:0.4" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>