<Window x:Class="Valorant_Instalocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:main="clr-namespace:Valorant_Instalocker.Main"
        Title="VALO.HUB - Instalocker" Height="650" Width="950"
        Background="#0F172A" WindowStartupLocation="CenterScreen"
        
        FontFamily="Segoe UI">


    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EF4444" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="🎯" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                    </Border>
                    <TextBlock Text="INSTALOCKER" FontSize="22" FontWeight="Black" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EF4444" Offset="0.0"/>
                                <GradientStop Color="#FB7185" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnNavDashboard" Content="{DynamicResource HomeTab}" Style="{StaticResource TabButton}" Foreground="#EF4444" BorderBrush="#EF4444" Click="SwitchTab_Click"/>
                    <Button x:Name="BtnNavMacros" Content="{DynamicResource MacrosTab}" Style="{StaticResource TabButton}" Click="SwitchTab_Click"/>
                    <Button x:Name="BtnNavSettings" Content="{DynamicResource SettingsTab}" Style="{StaticResource TabButton}" Click="SwitchTab_Click"/>
                    <Button x:Name="BtnNavAbout" Content="{DynamicResource AboutTab}" Style="{StaticResource TabButton}" Margin="0" Click="SwitchTab_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <ContentControl x:Name="MainContent" />

        </Grid>

        <Border Background="#334155" 
            CornerRadius="20" 
            Padding="8" 
            Margin="0,0,5,5"
            HorizontalAlignment="Right" 
            VerticalAlignment="Bottom"
            BorderBrush="#475569"
            BorderThickness="1" Grid.Row="1" RenderTransformOrigin="0.983,1.498">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusCircle}"/>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource ClientConnecting}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsClientLoggedIn, Source={x:Static main:AppStateManager.Instance}}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource ClientConnected}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>